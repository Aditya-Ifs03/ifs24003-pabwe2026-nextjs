# ---------------------------------------------------------------------------
# Contoh konfigurasi lingkungan aplikasi.
# Salin berkas ini menjadi .env, lalu sesuaikan nilainya bila diperlukan.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Base URL REST API Delcom (wajib diawali NEXT_PUBLIC_ supaya terekspos ke
# Client Component).
NEXT_PUBLIC_DELCOM_BASEURL=https://open-api.delcom.org/api/v1

# Port yang dipakai oleh server launcher (src/server.ts).
# Bila variabel ini tidak diisi pada .env, src/server.ts akan membacanya
# dari berkas .env.example ini.
APP_PORT=3000
